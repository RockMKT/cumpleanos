# Copiar a .env y completar. El .env vive en la raíz del proyecto (arriba del web
# root public/), así que nunca es accesible por HTTP. En Laravel Forge se edita
# desde el editor de "Environment" del sitio.

# ── Base de datos MySQL ──
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=ryf_cumpleanos
DATABASE_USER=root
DATABASE_PASSWORD=

# ── SendGrid — Grupo A (R&F Pilar, R&F Unicenter, R&F Palermo) ──
SENDGRID_API_KEY_GROUP_A=
SENDGRID_TEMPLATE_ID_GROUP_A=
SENDGRID_SENDER_EMAIL_GROUP_A=
SENDGRID_SENDER_NAME_GROUP_A=

# ── SendGrid — Grupo B (R&F Alto Rosario, R&F Oroño, R&F Savoy) ──
SENDGRID_API_KEY_GROUP_B=
SENDGRID_TEMPLATE_ID_GROUP_B=
SENDGRID_SENDER_EMAIL_GROUP_B=
SENDGRID_SENDER_NAME_GROUP_B=
